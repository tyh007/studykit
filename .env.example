# =============================================================================
# StudyKit Production Configuration
# =============================================================================
# 在部署到生产环境前，请务必修改以下所有敏感配置项。
# 不要将包含真实密码的 .env 文件提交到版本控制中。
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL 数据库密码（生产环境必须修改！）
# 生成方法: openssl rand -base64 32
DB_PASSWORD=change_me_in_production

# ── JWT ───────────────────────────────────────────────────────────────────────
# JWT 签名密钥（生产环境必须修改！）
# 用于签发和验证用户登录令牌。
# 要求: 至少 64 个字符的随机字符串
# 生成方法: openssl rand -base64 48 | head -c 64
JWT_SECRET=change_me_in_production

# ── NAS Data Directory ────────────────────────────────────────────────────────
# 仅 NAS 部署时需要设置此项。
# 本地运行不需要设置，Docker 会自动管理数据卷。
# NAS_DATA_DIR=/volume1/docker/studykit

# ── Frontend (Dev) ────────────────────────────────────────────────────────────
# 本地开发时，Vite 开发服务器会将 API 请求代理到此地址。
# 生产环境由 nginx 反向代理处理，无需设置此项。
VITE_API_URL=http://localhost:3001

# ── Rate Limiting (可选) ──────────────────────────────────────────────────────
# 每个 IP 在窗口期内允许的最大 API 请求数（生产环境建议启用）
# RATE_LIMIT_WINDOW_MS=900000    # 15 分钟（毫秒）
# RATE_LIMIT_MAX=100             # 窗口期内最大请求数

# ── CORS (可选) ───────────────────────────────────────────────────────────────
# 生产环境建议限制为具体域名，而非使用通配符
# CORS_ORIGIN=https://studykit.yourdomain.com
